# Local-only config for claude-lab (this file is git-ignored; never commit it)
GITHUB_USER=
GITHUB_REPO=claude-lab
# Private no-reply address so your real email never appears in commits
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=<user>@users.noreply.github.com
# Password for the site gate (reference only; gate.js stores a hash, not this value)
GATE_PASSWORD=
# Optional: fine-grained token with Contents: read/write on claude-lab.
# Prefer leaving this empty and letting macOS Keychain remember it after the first push.
GITHUB_TOKEN=
